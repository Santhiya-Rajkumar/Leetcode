import java.util.*;
class Main
{
    public static void main (String[] args) throws java.lang.Exception {
        // your code goes here
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        String ans="";
        boolean fl=true;
        for (int i = 0; i < s.length(); i++) {
           if(s.charAt(i)!=' '){
                   ans+=s.charAt(i);
                   fl=true;
           }
           else if(s.charAt(i)==' ' && fl==true){
               ans+=" ";
               fl=false;
           }

        }

        System.out.println(ans);
    }
}

