import java.io.File;
import java.io.FileReader;
import java.io.BufferedReader;
import java.io.IOException;
import java.io.FileWriter;
import java.io.FileOutputStream;
import java.io.FileInputStream;
public class File_Stream{
    public static void main(String[] args) throws IOException{
        try{
                FileOutputStream f=new FileOutputStream("test3.txt");  // ---->Checks if exists--if not create one and then write
                f.write(65);
                f.write(72);
                f.close();

                //For  Reading the newly created file
                FileInputStream f=new FileInputStream("test3.txt");
                int ch;
                while((ch=f.read())!=-1){
                    System.out.print((char)ch);
                }
            }
            catch(IOException e){
                e.printStackTrace();
            }
    }
}
