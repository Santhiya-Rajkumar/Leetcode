class Solution {
    public int lastRemaining(int n) {
        int step=1;
        int start=1;
        boolean left=true;
        while(n>1){
            if(left || n%2==1){
                start=start+step;
            }
            n/=2;
            step=step*2;
            left=!left;
        }
        return start;
    }
}
