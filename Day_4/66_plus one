class Solution {
    public int[] plusOne(int[] digits) {
        int len=digits.length;
        for(int itr=len-1;itr>=0;itr--){
          if(digits[itr]<9){
           digits[itr]++;
           return digits;
        }
        digits[itr]=0;
        }
        digits = new int[digits.length + 1];
        digits[0] = 1;
        return digits;
    }
}
