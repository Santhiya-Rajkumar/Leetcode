import java.util.*;
import java.util.stream.*;

class Uppercase {

    public static void main(String[] args) {
        List<String> l = Arrays.asList("Java", "You", "Me");
        List<String> res = l.stream()
                .map(String::toUpperCase)
                .collect(Collectors.toList());
        System.out.println(res);
    }
}
output:

[JAVA, YOU, ME]
